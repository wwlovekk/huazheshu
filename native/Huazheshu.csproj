<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../resources/icon.ico</ApplicationIcon>
    <AssemblyName>划着数</AssemblyName>
    <RootNamespace>Huazheshu</RootNamespace>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2428" />
    <PackageReference Include="Jint" Version="4.18.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" GeneratePathProperty="true" />
    <Reference Include="System.Runtime.WindowsRuntime" />
  </ItemGroup>
  <Target Name="CopyDependencyLicenses" AfterTargets="Build">
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)/LICENSE.txt;$(PkgMicrosoft_Web_WebView2)/NOTICE.txt"
          DestinationFiles="$(OutDir)licenses/WebView2.LICENSE.txt;$(OutDir)licenses/WebView2.NOTICE.txt" />
    <Copy SourceFiles="$(PkgNewtonsoft_Json)/LICENSE.md" DestinationFiles="$(OutDir)licenses/Newtonsoft.Json.LICENSE.md" />
    <Copy SourceFiles="../resources/Jint.LICENSE.txt;../resources/Acornima.LICENSE.txt" DestinationFolder="$(OutDir)licenses" />
  </Target>
</Project>
